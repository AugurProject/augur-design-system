---
/**
 * Home: product first. The message and the view's one green signal (the
 * Get started action) lead; a real query record, composed from package
 * exports, shows what the system is for; three entry points follow, each
 * with a live preview drawn from the package and its pages listed quietly.
 *
 * Identity lives in the masthead only, and project status in the footer
 * only, so neither repeats on this page.
 */
import { Button, Input, buttonVariants } from "@augurproject/design-system";
import { ReferenceRecordPanel } from "../examples/patterns/reference-record";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";

const doors = [
  {
    label: "Understand the system",
    title: "Foundations",
    href: "/foundations",
    description: "Identity, type, color, layout, interaction, and theming: the adopted rules everything else is built from.",
    preview: "foundations",
    links: [
      { href: "/foundations/identity", text: "Brand identity" },
      { href: "/foundations/fonts", text: "Fonts and typography" },
      { href: "/foundations/color", text: "Color system" },
      { href: "/foundations/layout-geometry", text: "Layout and geometry" },
      { href: "/foundations/interaction", text: "Interaction" },
      { href: "/foundations/theming", text: "Theming" },
    ],
  },
  {
    label: "Build with it",
    title: "Components and patterns",
    href: "/components",
    description: "Accessible React components and the compositions they form, documented from the real package exports.",
    preview: "components",
    links: [
      { href: "/getting-started", text: "Get started" },
      { href: "/components/button", text: "Button" },
      { href: "/components/card", text: "Card" },
      { href: "/components/dialog", text: "Dialog" },
      { href: "/components/input", text: "Input" },
      { href: "/patterns/page-header", text: "Page header" },
      { href: "/patterns/form-field", text: "Form field" },
      { href: "/patterns/empty-state", text: "Empty state" },
    ],
  },
  {
    label: "Extend it",
    title: "Reference",
    href: "/reference",
    description: "Package entries, authoring conventions, and how to contribute changes back to the system.",
    preview: "reference",
    links: [
      { href: "/patterns/reference-record", text: "Reference record" },
      { href: "/reference/package-entries", text: "Package entries" },
      { href: "/reference/component-conventions", text: "Component authoring" },
      { href: "/reference/contributing", text: "Contributing" },
    ],
  },
] as const;

// Swatches paint generated token variables; no color value is restated here.
const swatches = [
  { name: "Navy", token: "--augur-color-primary" },
  { name: "Green", token: "--augur-color-accent" },
  { name: "Deep", token: "--augur-color-accent-deep" },
  { name: "Paper", token: "--augur-color-neutral" },
  { name: "Graphite", token: "--augur-color-secondary" },
];
---
<BaseLayout
  title="Home"
  description="A shared interface language for Augur: foundations, components, and guidance for clear, consistent interfaces."
  shell={false}
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-message">
      <h1 id="home-title" class="augur-type-editorial-title">Make what<br />matters clear.</h1>
      <p class="home-lede augur-type-body">
        A shared interface language for Augur: foundations, components,
        and guidance for clear, consistent interfaces.
      </p>
      <div class="home-actions">
        <a class={`home-primary-action ${buttonVariants({ size: "lg" })}`} href={withBase("/getting-started")}>Get started</a>
        <a class="home-secondary-action augur-type-control" href={withBase("/proposal-review")}>See it applied</a>
      </div>
    </div>
    <figure class="home-hero-specimen">
      <ReferenceRecordPanel signal="quiet" headingLevel={2} />
      <figcaption class="augur-type-metadata">
        A query record: the question first, then status, equal choices, and the
        response. Composed from package components; submission is unavailable.
      </figcaption>
    </figure>
  </section>

  <section class="home-principles" aria-label="Principles">
    <div>
      <span class="augur-type-editorial-label">Purpose</span>
      <p class="augur-type-body">Ask. Vote. Reach a result.</p>
    </div>
    <div>
      <span class="augur-type-editorial-label">Character</span>
      <p class="augur-type-body">Clear-eyed, credible, neutral, human.</p>
    </div>
    <div>
      <span class="augur-type-editorial-label">System</span>
      <p class="augur-type-body">One language. Two everyday themes.</p>
    </div>
  </section>

  <section class="home-doors" aria-label="Routes into the system">
    {doors.map((door) => (
      <article class="home-door">
        <span class="augur-type-editorial-label home-door-label">{door.label}</span>
        <h2 class="augur-type-heading-2 home-door-title">
          <a href={withBase(door.href)}>{door.title}</a>
        </h2>
        <p class="augur-type-body home-door-description">{door.description}</p>
        <div class="home-door-preview" aria-hidden="true" inert>
          {door.preview === "foundations" && (
            <div class="home-preview-foundations">
              <ul class="home-preview-swatches">
                {swatches.map((swatch) => (
                  <li style={`background-color: var(${swatch.token})`} title={swatch.name} />
                ))}
              </ul>
              <div class="home-preview-type">
                <span class="augur-type-heading-2">Make it clear.</span>
                <span class="augur-type-body">Record the decision.</span>
              </div>
            </div>
          )}
          {door.preview === "components" && (
            <div class="home-preview-components">
              <Input defaultValue="Q3 records review" aria-label="Query name" tabIndex={-1} />
              <div class="home-preview-buttons">
                <Button variant="outline" tabIndex={-1}>Save draft</Button>
                <Button variant="secondary" tabIndex={-1}>Cancel</Button>
              </div>
            </div>
          )}
          {door.preview === "reference" && (
            <pre class="home-preview-code"><code>{`import { Button } from
  "@augurproject/design-system";
import "@augurproject/design-system/styles.css";`}</code></pre>
          )}
        </div>
        <ul class="home-door-links">
          {door.links.map((link) => (
            <li>
              <a class="augur-type-body" href={withBase(link.href)}>{link.text}</a>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>
</BaseLayout>
