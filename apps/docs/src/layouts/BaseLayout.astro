---
/**
 * Base layout for the docs shell (issues #7 and #55).
 *
 * Consumes the real workspace package stylesheet
 * (`@augurproject/design-system/styles.css`) as the only style source for
 * colors and font voices; `../styles/docs.css` adds shell chrome only.
 *
 * Theme contract: the inline script below re-applies a persisted choice
 * before first paint. It sets `data-theme` on `<html>` only for an explicit
 * light/dark override; with nothing persisted the attribute is absent so
 * the package's `prefers-color-scheme` fallback scope governs. No other theme logic
 * exists at the app level (see `src/components/ThemeToggle.tsx`).
 *
 * Navigation shell (#55): one derived model (`src/lib/navigation.ts`)
 * feeds the masthead's "Browse documentation" disclosure, the grouped
 * sidebar, the H2-derived "On this page" rail (when the page supplies
 * headings), and previous/next links from the maintained reading order.
 * The home page opts out of the sidebar/rail/pager with `shell={false}`:
 * it is the landing composition, not a document.
 */
import "@augurproject/design-system/styles.css";
import "../styles/docs.css";
import BrandLockup from "../components/BrandLockup.astro";
import ThemeToggle from "../components/ThemeToggle";
import { GitHubIcon } from "../components/icons";
import NavGroups from "../components/NavGroups.astro";
import PageActions from "../components/PageActions.astro";
import { normalizePath, withBase } from "../lib/base";
import { getDocsNav, pagerFor } from "../lib/navigation";

interface TocHeading {
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  /** Opt the page into Copy page / View as Markdown actions (#9): set when a clean `.md` endpoint exists. */
  markdown?: boolean;
  /** H2 headings for the "On this page" rail; collection pages supply them (#55). */
  toc?: TocHeading[];
  /** Full document shell: sidebar, contents rail, and pager. Default true. */
  shell?: boolean;
}

// MDX pages pass metadata through `frontmatter`; .astro pages pass props.
// MDX pages render the same shared page opening as DocPage (#65): the
// accessible h1 and page actions sit inside the `prose doc-page` article,
// so the title aligns to the centered reading column like every other
// documented page instead of the unconstrained main area. .astro pages
// control their own markup (the home page and section renderers).
const props = Astro.props as { frontmatter?: Props };
const fromMdx = props.frontmatter !== undefined;
const { title, description, toc, shell = true } = props.frontmatter ?? (Astro.props as Props);
const fullTitle = `${title} · Augur Design System`;
const currentPath = Astro.url.pathname;

const nav = await getDocsNav();
const pager = shell ? pagerFor(nav, currentPath) : {};
const showRail = shell && !!toc && toc.length > 0;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description ? <meta name="description" content={description} /> : null}
    <link rel="icon" href={withBase("/brand/icon/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={withBase("/brand/icon/favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase("/brand/icon/apple-touch-icon.png")} sizes="180x180" />
    <script is:inline>
      // Apply the persisted theme before first paint (see ThemeToggle.tsx
      // for the contract). No attribute = system preference governs.
      (() => {
        try {
          const stored = localStorage.getItem("augur-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.dataset.theme = stored;
          } else {
            delete document.documentElement.dataset.theme;
          }
        } catch {
          /* storage unavailable: system preference governs */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="masthead">
      <div class="masthead-inner">
        <a class="brand" href={withBase("/")} aria-label="Augur Design system">
          <BrandLockup descriptor="Design system" width={150} />
        </a>
        {/* Below 960px this disclosure is the full-height mobile sheet
            (issue #2): the augur.net menu treatment — Menu/Close swap,
            scroll lock, Escape/outside dismissal — over the same shared
            navigation model the sidebar renders. */}
        <details class="browse-docs">
          <summary class="browse-summary">
            <span class="browse-when-closed">Menu</span>
            <span class="browse-when-open">Close</span>
            <svg class="browse-icon browse-when-closed" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><line x1="3" y1="8" x2="21" y2="8" /><line x1="3" y1="16" x2="21" y2="16" /></svg>
            <svg class="browse-icon browse-when-open" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
          </summary>
          <div class="browse-panel">
            <nav aria-label="Documentation">
              <NavGroups nav={nav} currentPath={currentPath} />
            </nav>
            <div class="browse-theme">
              <span class="browse-theme-label augur-type-editorial-label">Theme</span>
              <ThemeToggle client:load showName />
            </div>
          </div>
        </details>
        <div class="masthead-actions">
          <ThemeToggle client:load />
          <a
            class="masthead-repo augur-type-control"
            href="https://github.com/jubalm/augur-design-system"
            aria-label="Repository"
            title="Repository"
          ><GitHubIcon className="masthead-repo-icon" size={18} /></a>
        </div>
      </div>
    </header>
    {
      shell ? (
        <div class="shell">
          <nav class="doc-sidebar" aria-label="Documentation">
            <NavGroups nav={nav} currentPath={currentPath} />
          </nav>
          <main id="main-content" class="doc-main">
            {fromMdx ? (
              <article class="prose doc-page">
                <div class="doc-page-head">
                  <h1 class="augur-type-editorial-title page-title">{title}</h1>
                  {props.frontmatter?.markdown ? (
                    // Shell MDX pages opted into Markdown parity (#9): Astro.url.pathname
                    // already includes the deployment base, so append `.md` directly.
                    <PageActions mdHref={`${normalizePath(currentPath)}.md`} />
                  ) : null}
                </div>
                <slot />
              </article>
            ) : (
              <slot />
            )}
            {(pager.previous || pager.next) && (
              <nav class="pager" aria-label="Document navigation">
                {pager.previous ? (
                  <a class="pager-prev" href={withBase(pager.previous.href)}>
                    <span class="pager-direction">Previous</span>
                    <span>{pager.previous.label}</span>
                  </a>
                ) : (
                  <span />
                )}
                {pager.next ? (
                  <a class="pager-next" href={withBase(pager.next.href)}>
                    <span class="pager-direction">Next</span>
                    <span>{pager.next.label}</span>
                  </a>
                ) : (
                  <span />
                )}
              </nav>
            )}
          </main>
          {showRail && toc && (
            <aside class="page-contents" aria-label="On this page">
              <span class="page-contents-label augur-type-editorial-label">On this page</span>
              <ul>
                {toc.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </aside>
          )}
        </div>
      ) : (
        <main id="main-content" class="site-main">
          {fromMdx ? (
            <article class="prose doc-page">
              <div class="doc-page-head">
                <h1 class="augur-type-editorial-title page-title">{title}</h1>
                {props.frontmatter?.markdown ? (
                  // Shell MDX pages opted into Markdown parity (#9): Astro.url.pathname
                  // already includes the deployment base, so append `.md` directly.
                  <PageActions mdHref={`${normalizePath(currentPath)}.md`} />
                ) : null}
              </div>
              <slot />
            </article>
          ) : (
            <slot />
          )}
        </main>
      )
    }
    <footer class="site-footer">
      <div class="footer-inner">
        <p class="augur-type-metadata" style="margin: 0;">
          Early development. Foundations, components, and patterns are available; final visual acceptance and release are pending.
        </p>
        <nav aria-label="Repository">
          <ul class="augur-type-metadata">
            <li><a href="https://github.com/jubalm/augur-design-system">Repository</a></li>
            <li><a href="https://github.com/jubalm/augur-design-system/blob/main/DESIGN.md">DESIGN.md</a></li>
            <li><a href="https://github.com/jubalm/augur-design-system/issues">Issues</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      // Mobile sheet dismissal (issue #2, the augur.net menu treatment):
      // Escape closes and returns focus to the summary; focus leaving the
      // disclosure and pointer-down outside close it; crossing to the
      // sidebar shell (>=960px) closes a still-open sheet. The scroll lock
      // itself is CSS (`:root:has(.browse-docs[open])` in docs.css).
      const menu = document.querySelector<HTMLDetailsElement>(".browse-docs");
      if (menu) {
        const summary = menu.querySelector("summary");
        menu.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || !menu.open) return;
          event.preventDefault();
          event.stopPropagation();
          menu.open = false;
          summary?.focus();
        });
        menu.addEventListener("focusout", (event) => {
          const next = event.relatedTarget;
          if (menu.open && next instanceof Node && !menu.contains(next)) menu.open = false;
        });
        document.addEventListener("pointerdown", (event) => {
          if (!menu.contains(event.target as Node)) menu.open = false;
        });
        window.matchMedia("(min-width: 960px)").addEventListener("change", () => {
          menu.open = false;
        });
      }
    </script>
  </body>
</html>
