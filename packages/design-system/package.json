{
  "name": "@augurproject/design-system",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/styles/theme.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./styles.css": "./src/styles/styles.css",
    "./tokens.tailwind.css": "./src/styles/tokens.tailwind.css",
    "./css/button.css": "./src/components/button/button.css",
    "./css/card.css": "./src/components/card/card.css",
    "./css/dialog.css": "./src/components/dialog/dialog.css",
    "./css/input.css": "./src/components/input/input.css",
    "./css/form-field.css": "./src/components/form-field/form-field.css",
    "./css/page-header.css": "./src/patterns/page-header/page-header.css",
    "./css/empty-state.css": "./src/patterns/empty-state/empty-state.css",
    "./icons/arrow-right.svg": "./src/icons/arrow-right.svg",
    "./icons/arrow-up-right.svg": "./src/icons/arrow-up-right.svg",
    "./icons/check.svg": "./src/icons/check.svg",
    "./icons/chevron-down.svg": "./src/icons/chevron-down.svg",
    "./icons/plus.svg": "./src/icons/plus.svg",
    "./icons/x.svg": "./src/icons/x.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/tools"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@fontsource/sora": "5.3.0"
  },
  "scripts": {
    "test": "bun test",
    "tokens:lint": "design.md lint ../../DESIGN.md",
    "tokens:generate": "bun src/tools/generate-tokens.ts",
    "tokens:check": "bun src/tools/generate-tokens.ts --check",
    "tokens:verify-failures": "bun src/tools/generate-tokens.ts --prove-failure",
    "registry:generate": "bun src/tools/generate-registry.ts",
    "registry:check": "bun src/tools/generate-registry.ts --check",
    "registry:validate": "cd ../.. && bunx shadcn@4.20.1 registry validate registry.json"
  },
  "peerDependencies": {
    "radix-ui": "1.6.7",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "radix-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "radix-ui": "1.6.7",
    "react": "^19.2.8"
  }
}
